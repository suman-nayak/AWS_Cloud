# Runtime server settings (Apache httpd reverse-proxies port 80 -> 127.0.0.1:3000)
PORT=3000
NODE_ENV=production

# Amazon RDS PostgreSQL connection string
# Format: postgresql://<username>:<password>@<rds-endpoint>:5432/<database_name>
DATABASE_URL=postgresql://cloudboard_user:CHANGE_ME@your-rds-endpoint.region.rds.amazonaws.com:5432/cloudboard

# Enable SSL for Amazon RDS connections (true in AWS, false for local PostgreSQL without SSL)
DB_SSL=true

# Amazon EFS mount path for shared file uploads across all EC2 instances
UPLOAD_DIR=/var/www/shared/uploads
